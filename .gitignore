node_modules/
.next/
out/
build/
dist/
# Compiled package output only. NOT an unanchored `lib/` — that also matches
# apps/web/src/lib and scripts/lib, which are source, and excluding them produces a repo
# that builds locally and fails in CI with "Cannot find module '@/lib/api'".
packages/*/lib/
functions/lib/
coverage/
*.tsbuildinfo

# Environment — never commit real credentials
.env
.env.local
.env.*.local
serviceAccount*.json

# Generated corpus. Regenerate with `npm run seed` (deterministic, seed-locked).
data/*.json
data/*.csv
!data/.gitkeep

# Generated test report consumed by the System Quality page
apps/web/public/quality-report.json

.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.DS_Store
Thumbs.db
