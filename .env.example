# ---------------------------------------------------------------------------
# TEMPLATE — copy to .env.local and fill in what you need
# ---------------------------------------------------------------------------
# RECLAIM runs end to end with zero external credentials. Everything below is
# optional; removing a block downgrades that subsystem to its offline
# implementation and the UI labels the downgrade explicitly.
# ---------------------------------------------------------------------------

# --- Run mode ---------------------------------------------------------------
# demo          : synthetic payment provider, fully offline, deterministic
# razorpay_test : real Razorpay test-mode API calls (needs keys below)
RECLAIM_MODE=demo

# memory    : seeded JSON corpus held in process (default, no setup)
# firestore : Cloud Firestore via the Admin SDK (needs service-account creds)
RECLAIM_STORE=memory

RECLAIM_MERCHANT_ID=merch_reclaim_demo
RECLAIM_SEED=20260901
LOG_LEVEL=info

# --- Firebase (client SDK: auth + analytics) --------------------------------
# Web API keys are public identifiers, not secrets. Access is controlled by
# Firestore security rules, which live in firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (server: Firestore reads/writes) --------------------
# Required only when RECLAIM_STORE=firestore. Generate a service-account key at
# Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@reclaim-razorpay.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# Or point at the local emulator instead of a real project:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Razorpay test mode -----------------------------------------------------
# Dashboard -> Settings -> API Keys, in TEST mode. Keys start with rzp_test_.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Reasoning layer --------------------------------------------------------
# With no key set, RECLAIM uses its built-in deterministic reasoner and the UI
# badges every explanation as such. Set one key to enable a hosted LLM.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Raise for reasoning models; Gemini 3.6 needs more than the 20000 default.
# LLM_TIMEOUT_MS=45000
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Guardrails (all enforced deterministically, never by the model) --------
POLICY_MAX_RETRIES=3
POLICY_COOLDOWN_HOURS=6
POLICY_AUTO_EXECUTE_CEILING_MINOR=5000000
POLICY_DAILY_CONTACT_CAP=2
POLICY_MIN_EXPECTED_VALUE_MINOR=2000
POLICY_QUIET_HOURS_START=21
POLICY_QUIET_HOURS_END=9
POLICY_MAX_CHARGEBACKS=2
POLICY_CASE_BUDGET_MINOR=30000
